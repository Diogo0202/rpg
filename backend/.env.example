# Supabase Auth: valida sessões recebidas pelas rotas de geração e probabilidade.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Origens liberadas pela API, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Segredo do worker confiável de extração. Não enviar ao navegador.
EXTRACTION_WORKER_TOKEN=
API_MAX_CONCURRENT_REQUESTS=10
# Vazio: processo local; runtime serverless/multiworker detectado exige supabase.
# Defina supabase em qualquer implantacao com mais de um processo/instancia.
API_CONCURRENCY_BACKEND=
# Apenas backend. Opcional para persistencia adicional dos logs da API.
SUPABASE_SERVICE_ROLE_KEY=

# Assistente IA: permanece desativado ate validar banco, cotas e credenciais.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini-2026-03-17
# Precos em USD por milhao de tokens. Rever antes de ativar ou trocar o modelo.
AI_INPUT_USD_PER_MILLION=0.75
AI_OUTPUT_USD_PER_MILLION=4.50
